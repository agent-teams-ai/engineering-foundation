{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "erasableSyntaxOnly": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "paths": {
      "@agent-teams/ci-input-proof": [
        "./packages/ci-input-proof/src/index.ts"
      ]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "scripts/**/*.mts",
    "scripts/release-bun-lock.ts",
    "tools/**/*.mts",
    "tools/git-environment.ts",
    "tools/profile-source.ts",
    "tools/repository-oxlint.ts",
    "scripts/materialize-validated-coverage.mjs",
    "tests/**/*.mts",
    "tests/support/release-changesets-fixture.ts",
    "tests/test-manifests-typescript.test.ts",
    "tests/repository-profile-lint.test.ts",
    "tests/repository-profile-git.test.ts",
    "tests/support/ci-input-proof-collector-install.ts"
  ]
}
