{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-teams.ai/engineering-foundation/repository-security-baseline/v1",
  "title": "Repository security baseline capability configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowDirectory",
    "dependencyReviewWorkflow",
    "sbomWorkflow",
    "privilegedJobs",
    "publishablePackageManifests"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workflowDirectory": { "$ref": "#/$defs/repositoryPath" },
    "dependencyReviewWorkflow": { "$ref": "#/$defs/repositoryPath" },
    "sbomWorkflow": { "$ref": "#/$defs/repositoryPath" },
    "privilegedJobs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workflowPath", "jobId", "permissions"],
        "properties": {
          "workflowPath": { "$ref": "#/$defs/repositoryPath" },
          "jobId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$" },
          "permissions": { "$ref": "#/$defs/permissions" }
        }
      }
    },
    "publishablePackageManifests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryPath" }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$"
    },
    "permissions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 30,
      "propertyNames": { "pattern": "^[a-z-]{1,50}$" },
      "additionalProperties": { "enum": ["none", "read", "write"] }
    }
  }
}
