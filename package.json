{
  "name": "@agent-teams/engineering-foundation-repository",
  "version": "0.0.0",
  "private": true,
  "description": "Repository for the Agent Teams engineering foundation.",
  "license": "Apache-2.0",
  "type": "module",
  "nx": {},
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json --pretty false",
    "check": "pnpm lint && pnpm typecheck && pnpm foundation:check:built && pnpm release-owned-files:check && pnpm architecture:patterns && pnpm architecture:patterns:test && pnpm nx:graph:check && pnpm test:built && pnpm package:check:built",
    "check:fast": "pnpm lint:fast && pnpm typecheck",
    "changeset": "changeset",
    "clean": "node scripts/clean.mjs",
    "foundation:check": "pnpm build && node packages/engineering-foundation/dist/cli.js check --consumer .",
    "foundation:check:built": "node packages/engineering-foundation/dist/cli.js check --consumer .",
    "lint": "pnpm lint:fast && pnpm lint:typed",
    "lint:fast": "oxlint --config .oxlintrc.json --deny-warnings --disable-nested-config .",
    "lint:typed": "oxlint --config .oxlintrc.type-aware.json --deny-warnings --disable-nested-config packages/engineering-foundation/src",
    "architecture:patterns": "node scripts/run-ast-grep.mjs scan --config sgconfig.yml --error=unused-suppression",
    "architecture:patterns:test": "node scripts/run-ast-grep.mjs test --config sgconfig.yml --skip-snapshot-tests",
    "dead-code:check": "knip --config knip.json --no-progress",
    "nx:graph:check": "nx show projects",
    "check:affected": "nx affected -t build --exclude=@agent-teams/engineering-foundation-repository",
    "package:check": "pnpm build && pnpm package:check:built",
    "package:check:built": "node scripts/prepare-package.mjs && publint packages/engineering-foundation && attw --pack --profile esm-only packages/engineering-foundation && node scripts/pack-test.mjs",
    "parser-spike:check": "pnpm --filter @agent-teams/source-dependency-parser-spike run check",
    "release:publish": "pnpm check && changeset publish",
    "release-owned-files:check": "node scripts/check-release-owned-files.mjs",
    "security:workflows": "node scripts/security-toolchain.mjs",
    "release:version": "changeset version && pnpm build && node packages/engineering-foundation/dist/cli.js public-api-promote-release --consumer .",
    "spike:source-parser": "pnpm --filter @agent-teams/source-dependency-parser-spike run spike",
    "test": "pnpm build && pnpm test:built",
    "test:built": "node --test --test-concurrency=1 tests/*.test.mjs",
    "typecheck": "tsc --build tsconfig.json --pretty false"
  },
  "devDependencies": {
    "@ast-grep/cli": "catalog:",
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@openai/codex": "catalog:",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "catalog:",
    "ajv": "catalog:",
    "fast-check": "catalog:",
    "knip": "catalog:",
    "nx": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  }
}
