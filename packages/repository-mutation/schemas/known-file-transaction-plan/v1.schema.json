{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.ai/schemas/known-file-transaction-plan/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocol", "operations", "planDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocol": { "const": "agent-teams.repository-mutation.known-file/v1" },
    "operations": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/operation" }
    },
    "planDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentBase64", "digest", "mode", "size"],
      "properties": {
        "contentBase64": { "type": "string", "contentEncoding": "base64" },
        "digest": { "$ref": "#/$defs/sha256" },
        "mode": { "type": "integer", "minimum": 0, "maximum": 511 },
        "size": { "type": "integer", "minimum": 0, "maximum": 8388608 }
      }
    },
    "precondition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "absent" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "acceptedPreimages"],
          "properties": {
            "state": { "const": "known-file" },
            "acceptedPreimages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "$ref": "#/$defs/image" }
            }
          }
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "precondition", "postimage"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "precondition": { "$ref": "#/$defs/precondition" },
        "postimage": { "$ref": "#/$defs/image" }
      }
    }
  }
}
