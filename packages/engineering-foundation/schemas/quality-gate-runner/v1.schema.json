{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-teams.ai/engineering-foundation/quality-gate-runner/v1",
  "title": "Deterministic quality gate runner configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageManager", "profiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageManager": { "const": "pnpm" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "concurrency", "tasks"],
        "properties": {
          "id": { "$ref": "#/$defs/profileId" },
          "concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id"],
              "properties": {
                "id": { "$ref": "#/$defs/scriptId" },
                "needs": {
                  "type": "array",
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/scriptId" }
                },
                "after": {
                  "type": "array",
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/scriptId" }
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "scriptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$"
    }
  }
}
