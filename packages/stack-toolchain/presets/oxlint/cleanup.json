{
  "categories": {
    "correctness": "off"
  },
  "plugins": ["eslint"],
  "options": {
    "typeAware": false,
    "typeCheck": false
  },
  "rules": {
    "prefer-const": [
      "warn",
      {
        "destructuring": "all",
        "ignoreReadBeforeAssign": true
      }
    ],
    "no-useless-rename": "warn",
    "no-useless-computed-key": ["warn", { "enforceForClassMembers": false }]
  }
}
