{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "erasableSyntaxOnly": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "paths": {
      "@agent-teams/ci-input-proof": [
        "./packages/ci-input-proof/src/index.ts"
      ]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "scripts/**/*.mts",
    "scripts/release-bun-lock.ts",
    "scripts/release-candidate-host.ts",
    "scripts/release-candidate-observation.ts",
    "scripts/packed-release-checks.ts",
    "scripts/packaging-pnpm.ts",
    "scripts/public-docs-quickstart.ts",
    "scripts/public-docs-documented-e2e.ts",
    "scripts/pack-quality-assets.ts",
    "tools/**/*.mts",
    "scripts/materialize-validated-coverage.mjs",
    "tests/**/*.mts",
    "tests/support/release-changesets-fixture.ts",
    "tests/support/process-runtime-windows-protocol.ts",
    "tests/support/repository-source.ts",
    "tests/release-candidate-host.test.ts",
    "tests/features/release-checks/candidate-checking.test.ts",
    "tests/features/release-checks/conformance.test.ts",
    "tests/test-manifests-typescript.test.ts",
    "tests/source-inline-types.test.ts",
    "tests/package-export-matcher.test.ts",
    "tests/public-docs-documented.test.ts",
    "tests/support/ci-input-proof-collector-install.ts",
    "tests/sdk-json-record.test.ts",
    "tests/architecture-baseline-replacement.test.ts",
    "tools/git-environment.ts",
    "tools/profile-source.ts",
    "tools/repository-oxlint.ts",
    "tools/check-changed-repository.ts",
    "tests/repository-profile-lint.test.ts",
    "tests/repository-profile-git.test.ts",
    "tests/local-mode-bun.test.ts",
    "tests/features/quality-coverage/governed-assets.test.ts",
    "packages/stack-toolchain/tests/**/*.ts",
    "scripts/packed-stack-toolchain-qualification.ts",
    "tests/support/process-runtime-cancellation-fixture.ts",
    "tests/github-release-reconciliation.test.ts",
    "scripts/npm-registry-read.ts",
    "scripts/npm-registry-history.ts",
    "scripts/npm-bootstrap-recovery.ts",
    "tests/npm-bootstrap-recovery.test.ts",
    "tests/support/npm-bootstrap-recovery-fixtures.ts"
  ]
}
