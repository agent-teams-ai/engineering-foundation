{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.ai/schemas/qualified-docs-cohort/v3",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/$defs/cohortCore"
    },
    {
      "type": "object",
      "required": [
        "lifecycleState",
        "canaryRepositoryIds"
      ],
      "properties": {
        "lifecycleState": {
          "enum": [
            "QUALIFIED",
            "CANARY",
            "RECOMMENDED"
          ]
        },
        "canaryRepositoryIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "cohortBinding": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/cohortCore"
        }
      ],
      "unevaluatedProperties": false
    },
    "cohortCore": {
      "type": "object",
      "required": [
        "schemaVersion",
        "cohortId",
        "channel",
        "recordDigest",
        "qualificationEventDigest",
        "eligibleAfter",
        "upgradeFrom",
        "rollbackTo",
        "packages",
        "workflow",
        "assets",
        "schemas",
        "runtime",
        "candidateDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "cohortId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "channel": {
          "enum": [
            "rc",
            "stable"
          ]
        },
        "recordDigest": {
          "$ref": "#/$defs/nonzeroSha256"
        },
        "qualificationEventDigest": {
          "$ref": "#/$defs/nonzeroSha256"
        },
        "eligibleAfter": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "upgradeFrom": {
          "$ref": "#/$defs/cohortIds"
        },
        "rollbackTo": {
          "$ref": "#/$defs/cohortIds"
        },
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repositoryMutation",
            "documentAuthoring",
            "docsProtocol",
            "docsProtocolAgentTeams",
            "engineeringFoundation"
          ],
          "properties": {
            "repositoryMutation": {
              "$ref": "#/$defs/package"
            },
            "documentAuthoring": {
              "$ref": "#/$defs/package"
            },
            "docsProtocol": {
              "$ref": "#/$defs/package"
            },
            "docsProtocolAgentTeams": {
              "$ref": "#/$defs/package"
            },
            "engineeringFoundation": {
              "$ref": "#/$defs/package"
            }
          }
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "path",
            "revision",
            "blobSha"
          ],
          "properties": {
            "repository": {
              "const": "agent-teams-ai/.github"
            },
            "path": {
              "const": ".github/workflows/docs-protocol-check.yml"
            },
            "revision": {
              "$ref": "#/$defs/nonzeroSha"
            },
            "blobSha": {
              "$ref": "#/$defs/nonzeroSha"
            }
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skillDigest",
            "callerWorkflowDigest",
            "assetCatalogDigest",
            "transitionCatalogDigest"
          ],
          "properties": {
            "skillDigest": {
              "$ref": "#/$defs/nonzeroSha256"
            },
            "callerWorkflowDigest": {
              "$ref": "#/$defs/nonzeroSha256"
            },
            "assetCatalogDigest": {
              "$ref": "#/$defs/nonzeroSha256"
            },
            "transitionCatalogDigest": {
              "$ref": "#/$defs/nonzeroSha256"
            }
          }
        },
        "schemas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consumerIntegration",
            "managedState",
            "docsProtocol",
            "qualificationReceipt"
          ],
          "properties": {
            "consumerIntegration": {
              "const": 4
            },
            "managedState": {
              "const": 3
            },
            "docsProtocol": {
              "const": 1
            },
            "qualificationReceipt": {
              "const": 1
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "selectedLane",
            "node",
            "pnpm",
            "qualificationRuntime",
            "runtimeClosure"
          ],
          "properties": {
            "policy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version",
                "digest"
              ],
              "properties": {
                "id": {
                  "const": "agent-teams.docs-protocol-current-policy"
                },
                "version": {
                  "const": "2.0.0"
                },
                "digest": {
                  "$ref": "#/$defs/nonzeroSha256"
                }
              }
            },
            "selectedLane": {
              "enum": [
                "node-24-production-default",
                "node-26-managed-qualified"
              ]
            },
            "node": {
              "enum": [
                ">=24.18.0 <25",
                ">=26.0.0 <27"
              ]
            },
            "pnpm": {
              "const": ">=11.17.0 <12"
            },
            "qualificationRuntime": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "nodeVersion",
                "pnpmVersion",
                "platform",
                "architecture"
              ],
              "properties": {
                "nodeVersion": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "pnpmVersion": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "platform": {
                  "enum": [
                    "linux",
                    "macos",
                    "windows"
                  ]
                },
                "architecture": {
                  "enum": [
                    "x64",
                    "arm64"
                  ]
                }
              }
            },
            "runtimeClosure": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "domain",
                "digest"
              ],
              "properties": {
                "domain": {
                  "const": "agent-teams.docs-runtime-closure/v2"
                },
                "digest": {
                  "$ref": "#/$defs/nonzeroSha256"
                }
              }
            }
          }
        },
        "candidateDigest": {
          "$ref": "#/$defs/nonzeroSha256"
        }
      }
    },
    "nonzeroSha": {
      "type": "string",
      "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
    },
    "nonzeroSha256": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "cohortIds": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "integrity"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha512-[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  }
}
