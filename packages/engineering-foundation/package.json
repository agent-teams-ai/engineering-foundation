{
  "name": "@agent-teams/engineering-foundation",
  "version": "1.0.1",
  "description": "Versioned engineering policy, tooling, and conformance for Agent Teams repositories.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build tsconfig.json --pretty false"
  },
  "bin": {
    "agent-teams-foundation": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./local-mode": {
      "types": "./dist/local-mode/index.d.ts",
      "import": "./dist/local-mode/index.js"
    },
    "./scaffolding/qualification": {
      "types": "./dist/scaffolding/qualification.d.ts",
      "import": "./dist/scaffolding/qualification.js"
    },
    "./scaffolding": {
      "types": "./dist/scaffolding/index.d.ts",
      "import": "./dist/scaffolding/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./presets/*": "./presets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets/transaction-coordination/historical/document-plan-v1.schema.json",
    "presets/oxlint/base.json",
    "presets/oxlint/maintainability-tests.json",
    "presets/oxlint/maintainability.json",
    "presets/oxlint/node.json",
    "presets/oxlint/type-aware.json",
    "presets/typescript/base.json",
    "presets/typescript/node.json",
    "schemas/architecture-source-dependencies/v1.schema.json",
    "schemas/architecture-source-dependencies/v2.schema.json",
    "schemas/contract-json-schema-release-baseline/v1.schema.json",
    "schemas/contract-json-schema-releases/v1.schema.json",
    "schemas/contract-protobuf-breaking-qualification/v1.schema.json",
    "schemas/contract-protobuf-evolution-baseline/v1.schema.json",
    "schemas/contract-protobuf-evolution/v1.schema.json",
    "schemas/documentation-local-references/v1.schema.json",
    "schemas/foundation-command-error/v1.schema.json",
    "schemas/foundation-config/v1.schema.json",
    "schemas/foundation-check-report/v1.schema.json",
    "schemas/foundation-transaction-envelope/v2.schema.json",
    "schemas/governance-architecture-decision-baseline/v1.schema.json",
    "schemas/governance-architecture-decisions/v1.schema.json",
    "schemas/package-public-api-baseline/v1.schema.json",
    "schemas/package-public-api-compatibility/v1.schema.json",
    "schemas/quality-executable-specification-catalog/v1.schema.json",
    "schemas/quality-executable-specifications/v1.schema.json",
    "schemas/quality-gate-run-report/v1.schema.json",
    "schemas/quality-gate-runner/v1.schema.json",
    "schemas/quality-suppression-governance/v1.schema.json",
    "schemas/repository-agent-workflow/v1.schema.json",
    "schemas/repository-security-baseline/v1.schema.json",
    "schemas/scaffold-authority-evidence/v1.schema.json",
    "schemas/scaffold-intent/v1.schema.json",
    "schemas/scaffold-plan/v1.schema.json",
    "schemas/scaffold-receipt/v1.schema.json",
    "schemas/scaffold-recovery-journal/v1.schema.json",
    "schemas/scaffold-target-catalog/v1.schema.json",
    "schemas/scaffolding-config/v1.schema.json",
    "schemas/workspace-dependency-declarations/v1.schema.json",
    "assets/windows-managed-process/bootstrap.ps1",
    "assets/windows-managed-process/WindowsManagedProcess.cs",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-teams-ai/engineering-foundation.git",
    "directory": "packages/engineering-foundation"
  },
  "homepage": "https://github.com/agent-teams-ai/engineering-foundation#readme",
  "bugs": {
    "url": "https://github.com/agent-teams-ai/engineering-foundation/issues"
  },
  "agentTeamsFoundation": {
    "metadataSchemaVersion": 1,
    "localModeProtocolVersion": 1,
    "compatibleLocalModeProtocolVersions": [
      1
    ]
  },
  "dependencies": {
    "@agent-teams/document-authoring": "workspace:*",
    "@agent-teams/repository-mutation": "workspace:*",
    "@microsoft/api-extractor": "catalog:",
    "@microsoft/api-extractor-model": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "oxc-parser": "catalog:",
    "proper-lockfile": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/proper-lockfile": "catalog:",
    "typescript": "catalog:"
  }
}
