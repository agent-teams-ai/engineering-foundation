{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.ai/schemas/docs-consumer-integration-profile/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "integrationRoot",
    "packageManager",
    "profilePath",
    "skillPath",
    "callerWorkflowPath",
    "managedStatePath",
    "cohort",
    "qualification"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "id",
        "nameWithOwner"
      ],
      "properties": {
        "provider": {
          "const": "github"
        },
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "nameWithOwner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        }
      }
    },
    "integrationRoot": {
      "const": "."
    },
    "packageManager": {
      "const": "pnpm"
    },
    "profilePath": {
      "const": "architecture/foundation/docs-protocol.yaml"
    },
    "skillPath": {
      "const": ".agents/skills/docs-authoring/SKILL.md"
    },
    "callerWorkflowPath": {
      "const": ".github/workflows/docs-protocol.yml"
    },
    "managedStatePath": {
      "const": "architecture/foundation/docs-protocol-managed-state.json"
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractPath",
        "gateCommand"
      ],
      "properties": {
        "contractPath": {
          "const": "architecture/foundation/docs-protocol-qualification.json"
        },
        "gateCommand": {
          "const": "pnpm docs:protocol:check"
        }
      }
    },
    "governedDocsRoots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._@-]{1,255}(?:/[A-Za-z0-9._@-]{1,255})*$"
      }
    },
    "cohort": {
      "$ref": "#/$defs/cohortBinding"
    }
  },
  "$defs": {
    "cohortBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "cohortId",
        "channel",
        "recordDigest",
        "qualificationEventDigest",
        "eligibleAfter",
        "upgradeFrom",
        "rollbackTo",
        "packages",
        "workflow",
        "assets",
        "schemas",
        "runtime"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "cohortId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "channel": {
          "enum": [
            "rc",
            "stable"
          ]
        },
        "recordDigest": {
          "$ref": "#/$defs/nonzeroSha256"
        },
        "qualificationEventDigest": {
          "$ref": "#/$defs/nonzeroSha256"
        },
        "eligibleAfter": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "upgradeFrom": {
          "$ref": "#/$defs/cohortIds"
        },
        "rollbackTo": {
          "$ref": "#/$defs/cohortIds"
        },
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "docsProtocol",
            "engineeringFoundation"
          ],
          "properties": {
            "docsProtocol": {
              "$ref": "#/$defs/package"
            },
            "engineeringFoundation": {
              "$ref": "#/$defs/package"
            }
          }
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "path",
            "revision",
            "blobSha"
          ],
          "properties": {
            "repository": {
              "const": "agent-teams-ai/.github"
            },
            "path": {
              "const": ".github/workflows/docs-protocol-check.yml"
            },
            "revision": {
              "type": "string",
              "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
            },
            "blobSha": {
              "type": "string",
              "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
            }
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skillDigest",
            "callerWorkflowDigest",
            "assetCatalogDigest",
            "transitionCatalogDigest"
          ],
          "properties": {
            "skillDigest": {
              "$ref": "#/$defs/nonzeroSha256"
            },
            "callerWorkflowDigest": {
              "$ref": "#/$defs/nonzeroSha256"
            },
            "assetCatalogDigest": {
              "$ref": "#/$defs/nonzeroSha256"
            },
            "transitionCatalogDigest": {
              "$ref": "#/$defs/nonzeroSha256"
            }
          }
        },
        "schemas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consumerIntegration",
            "managedState",
            "docsProtocol"
          ],
          "properties": {
            "consumerIntegration": {
              "const": 1
            },
            "managedState": {
              "const": 1
            },
            "docsProtocol": {
              "const": 1
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node",
            "pnpm",
            "runtimeClosureDigest"
          ],
          "properties": {
            "node": {
              "const": ">=24.18.0 <25"
            },
            "pnpm": {
              "const": ">=11.17.0 <12"
            },
            "runtimeClosureDigest": {
              "$ref": "#/$defs/nonzeroSha256"
            }
          }
        }
      }
    },
    "nonzeroSha256": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "cohortIds": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "integrity"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha512-[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  }
}
