{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-teams.ai/engineering-foundation/quality-source-coverage/v4",
  "title": "Production quality source coverage profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourcePolicyPath",
    "suppressionPolicyPath",
    "featureProfilePath",
    "lintConfigPath",
    "toolchainConfigPath",
    "scripts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "sourcePolicyPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:ya?ml|json)$"
    },
    "suppressionPolicyPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:ya?ml|json)$"
    },
    "featureProfilePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:ya?ml|json)$"
    },
    "lintConfigPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:ya?ml|json)$"
    },
    "bridgeAdmissionsPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:ya?ml|json)$"
    },
    "scripts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fast",
        "full",
        "scope",
        "typed"
      ],
      "properties": {
        "fast": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_:-]+$"
        },
        "full": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_:-]+$"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_:-]+$"
        },
        "typed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_:-]+$"
        }
      }
    },
    "nativeChecks": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "boundaryId",
          "script"
        ],
        "properties": {
          "boundaryId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "script": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_:-]+$"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "boundaryId",
          "script"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[?*]).+\\.(?:proto|sql)$"
          },
          "kind": {
            "enum": [
              "protobuf",
              "sql-migration"
            ]
          },
          "boundaryId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "script": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_:-]+$"
          }
        }
      }
    },
    "toolchainConfigPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:ya?ml|json)$"
    }
  }
}
