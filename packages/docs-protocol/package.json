{
  "name": "@agent-teams/docs-protocol",
  "version": "0.5.0",
  "description": "Deterministic documentation authoring and agent-context protocol for any repository.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "agent-teams-docs": "./dist/cli.js",
    "docs-protocol": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./qualification": {
      "types": "./dist/qualification/index.d.ts",
      "import": "./dist/qualification/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas/docs-protocol/v1.schema.json",
    "schemas/docs-protocol-profile/v3.schema.json",
    "schemas/docs-protocol-profile/v4.schema.json",
    "schemas/docs-protocol-portable-command-envelope/v1.schema.json",
    "schemas/docs-protocol-portable-command-envelope/v2.schema.json",
    "schemas/docs-protocol-portable-command-envelope/v3.schema.json",
    "README.md",
    "docs",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json --pretty false",
    "test": "pnpm build && node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-teams-ai/engineering-foundation.git",
    "directory": "packages/docs-protocol"
  },
  "homepage": "https://github.com/agent-teams-ai/engineering-foundation#readme",
  "bugs": {
    "url": "https://github.com/agent-teams-ai/engineering-foundation/issues"
  },
  "dependencies": {
    "@agent-teams/document-authoring": "workspace:*",
    "@agent-teams/repository-mutation": "workspace:*",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "minisearch": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
