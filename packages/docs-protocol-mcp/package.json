{
  "name": "@agent-teams/docs-protocol-mcp",
  "version": "0.2.8",
  "description": "Open-source read-only MCP stdio adapter for documentation governed by the Agent Teams docs protocol in any repository.",
  "homepage": "https://github.com/agent-teams-ai/engineering-foundation#readme",
  "bugs": {
    "url": "https://github.com/agent-teams-ai/engineering-foundation/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-teams-ai/engineering-foundation.git",
    "directory": "packages/docs-protocol-mcp"
  },
  "bin": {
    "docs-protocol-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json --pretty false",
    "test": "pnpm build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@agent-teams/docs-protocol": "workspace:*",
    "@modelcontextprotocol/server": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^24.18.0 || ^26.0.0",
    "pnpm": ">=11.17.0 <12"
  }
}
