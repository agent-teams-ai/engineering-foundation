{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.ai/schemas/foundation-transaction-envelope/v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operationKind", "recoveryHandler", "foundation", "adapterContractVersion", "payloadKind", "state", "journal", "payloadDigest", "envelopeDigest"],
  "properties": {
    "schemaVersion": { "const": 5 },
    "operationKind": { "const": "known-file-transaction" },
    "recoveryHandler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contractVersion"],
      "properties": {
        "id": { "const": "foundation.replace-known-file" },
        "contractVersion": { "const": 1 }
      }
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "buildIdentity"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "buildIdentity": { "$ref": "#/$defs/sha256" }
      }
    },
    "adapterContractVersion": { "const": 1 },
    "payloadKind": { "const": "known-file-transaction-journal/v1" },
    "state": { "enum": ["APPLYING", "COMMITTED"] },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "plan", "operations", "createdDirectories"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "plan": { "$ref": "https://agent-teams.ai/schemas/known-file-transaction-plan/v1" },
        "operations": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/journalOperation" } },
        "createdDirectories": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/createdDirectory" } }
      }
    },
    "payloadDigest": { "$ref": "#/$defs/sha256" },
    "envelopeDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["birthtimeNs", "dev", "ino"],
      "properties": {
        "birthtimeNs": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "dev": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "ino": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      }
    },
    "journalOperation": {
      "type": "object",
      "required": ["path", "state"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "state": { "enum": ["already-satisfied", "pending", "temporary-ready", "publishing", "published"] },
        "matchedPreimage": { "type": "integer", "minimum": 0, "maximum": 15 },
        "temporaryIdentity": { "$ref": "#/$defs/identity" }
      },
      "additionalProperties": false
    },
    "createdDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "identity"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "identity": { "$ref": "#/$defs/identity" }
      }
    }
  }
}
