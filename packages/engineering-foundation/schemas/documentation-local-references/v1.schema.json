{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-teams.ai/engineering-foundation/documentation-local-references/v1",
  "title": "Local Markdown reference capability configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "markdownRoots", "anchorProfile"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "markdownRoots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryDirectory" }
    },
    "anchorProfile": {
      "enum": ["github", "none"]
    }
  },
  "$defs": {
    "repositoryDirectory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[*?{}[\\]]).+$"
    }
  }
}
