{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-teams.ai/engineering-foundation/quality-source-topology/v1",
  "title": "Consumer quality source topology",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "censusRoots",
    "packageRoots",
    "sourceRoots",
    "testRoots",
    "excludedRoots",
    "toolingFiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "censusRoots": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "const": "."
          },
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*[\\\\\\u0000-\\u001f\\u007f*?\\[\\]{}])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//).+(?<!/)$"
          }
        ]
      }
    },
    "packageRoots": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "const": "."
          },
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*[\\\\\\u0000-\\u001f\\u007f*?\\[\\]{}])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//).+(?<!/)$"
          }
        ]
      }
    },
    "sourceRoots": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "const": "."
          },
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*[\\\\\\u0000-\\u001f\\u007f*?\\[\\]{}])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//).+(?<!/)$"
          }
        ]
      }
    },
    "testRoots": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "const": "."
          },
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*[\\\\\\u0000-\\u001f\\u007f*?\\[\\]{}])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//).+(?<!/)$"
          }
        ]
      }
    },
    "excludedRoots": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "const": "."
          },
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*[\\\\\\u0000-\\u001f\\u007f*?\\[\\]{}])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//).+(?<!/)$"
          }
        ]
      }
    },
    "toolingFiles": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*[\\\\\\u0000-\\u001f\\u007f*?\\[\\]{}])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//).+(?<!/)$"
      }
    },
    "derivedFrom": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*[\\\\\\u0000-\\u001f\\u007f*?\\[\\]{}])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//).+(?<!/)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
