{
  "name": "@agent-teams/feature-module-standard",
  "version": "0.3.0",
  "description": "Opt-in checks for the Feature Module Standard: a pure kernel, shared fixtures and a Node runner over the Foundation file graph.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-teams-ai/engineering-foundation.git",
    "directory": "packages/feature-module-standard"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json --pretty false"
  },
  "devDependencies": {
    "@agent-teams/engineering-foundation": "workspace:*",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@agent-teams/engineering-foundation": "workspace:^1.8.0 || ^2.0.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "@agent-teams/engineering-foundation": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.18.0 || ^26.0.0",
    "pnpm": ">=11.17.0 <12"
  }
}
