{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-teams.ai/engineering-foundation/documentation-local-references/v2",
  "title": "Local Markdown references with exact historical artifact declarations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "markdownRoots", "anchorProfile", "historicalArtifacts"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "markdownRoots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryDirectory"
      }
    },
    "anchorProfile": {
      "enum": ["github", "none"]
    },
    "historicalArtifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/historicalArtifact"
      }
    }
  },
  "$defs": {
    "repositoryDirectory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[*?{}[\\]]).+$"
    },
    "historicalArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "references"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[*?{}[\\]]).+$",
          "allOf": [
            {
              "type": "string",
              "pattern": "\\.[mM][dD]$"
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/historicalReference"
          }
        }
      }
    },
    "historicalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "line", "column", "rawTarget"],
      "properties": {
        "kind": {
          "enum": ["link", "image", "definition"]
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "rawTarget": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    }
  }
}
