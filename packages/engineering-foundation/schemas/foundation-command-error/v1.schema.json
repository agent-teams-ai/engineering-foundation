{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-teams.ai/engineering-foundation/foundation-command-error/v1",
  "title": "Agent Teams Engineering Foundation command error",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "outcome", "error"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "outcome": {
      "enum": ["cancelled", "execution-failure", "invalid-input"]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
