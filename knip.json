{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["mkfifo"],
  "ignoreDependencies": ["@arethetypeswrong/cli", "@openai/codex", "c8", "publint", "vfile"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "tests/*.test.mjs",
        "tests/fixtures/coverage-process-tree.fixture.mjs",
        "tests/fixtures/foundation-transaction-holder.mjs",
        "tests/fixtures/scaffolding-crash-worker.mjs",
        "tests/support/document-authoring-schema-closures.mjs",
        "tests/fixtures/**/scripts/*.mjs"
      ],
      "project": [
        "scripts/*.mjs",
        "tests/**/*.mjs"
      ]
    },
    "packages/engineering-foundation": {
      "entry": [
        "src/capabilities/*/module.ts",
        "src/capabilities/*/qualification/module.ts",
        "src/public-api-surface.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "packages/document-authoring": {
      "entry": ["tests/fixtures/public-api/crash-worker.mjs"],
      "project": ["src/**/*.ts", "tests/**/*.mjs"]
    },
    "packages/docs-protocol": {
      "project": ["src/**/*.ts"]
    },
    "packages/docs-protocol-agent-teams": {
      "project": ["src/**/*.ts"]
    },
    "packages/docs-protocol-mcp": {
      "project": ["src/**/*.ts"]
    },
    "packages/repository-mutation": {
      "project": ["src/**/*.ts"]
    },
    "spikes/source-dependency-parser": {
      "project": ["*.mjs"]
    }
  }
}
