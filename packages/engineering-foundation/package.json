{
  "name": "@agent-teams/engineering-foundation",
  "version": "0.1.0",
  "description": "Versioned engineering policy, tooling, and conformance for Agent Teams repositories.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "agent-teams-foundation": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./local-mode": {
      "types": "./dist/local-mode/index.d.ts",
      "import": "./dist/local-mode/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-teams-ai/engineering-foundation.git",
    "directory": "packages/engineering-foundation"
  },
  "homepage": "https://github.com/agent-teams-ai/engineering-foundation#readme",
  "bugs": {
    "url": "https://github.com/agent-teams-ai/engineering-foundation/issues"
  },
  "dependencies": {
    "proper-lockfile": "catalog:"
  }
}
