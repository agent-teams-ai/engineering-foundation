{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.dev/schemas/public-managed-registry-canary-receipt-v1.schema.json",
  "title": "Public managed registry canary receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "run", "authority", "packages", "installs", "portableNegative", "managedQualification", "hostile", "receiptDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "runId", "runAttempt", "createdAt"],
      "properties": {
        "repository": { "const": "agent-teams-ai/engineering-foundation" },
        "runId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedCommit", "registry"],
      "properties": {
        "expectedCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "registry": { "const": "https://registry.npmjs.org/" }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/package" }
    },
    "installs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manager", "lockfileDigest", "packageCount"],
        "properties": {
          "manager": { "enum": ["npm", "pnpm"] },
          "lockfileDigest": { "$ref": "#/$defs/sha256" },
          "packageCount": { "const": 6 }
        }
      }
    },
    "portableNegative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapterAbsent", "forbiddenTermsAbsent", "lockfileDigest"],
      "properties": {
        "adapterAbsent": { "const": true },
        "forbiddenTermsAbsent": { "const": true },
        "lockfileDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "managedQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceClass", "cohortAdmissible", "receiptDigest", "sourceUnchanged"],
      "properties": {
        "evidenceClass": { "const": "local-development" },
        "cohortAdmissible": { "const": false },
        "receiptDigest": { "$ref": "#/$defs/sha256" },
        "sourceUnchanged": { "const": true }
      }
    },
    "hostile": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mode", "outcome"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["deterministic-policy", "installed-execution"] },
          "outcome": { "enum": ["passed", "rejected"] }
        }
      }
    },
    "receiptDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "integrity", "latest", "provenanceCommit", "tarballEntries"],
      "properties": {
        "name": { "type": "string", "pattern": "^@agent-teams/[a-z0-9-]+$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$" },
        "integrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$" },
        "latest": { "type": "string" },
        "provenanceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "tarballEntries": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
