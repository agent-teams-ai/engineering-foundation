{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-teams.ai/engineering-foundation/foundation-config/v1",
  "title": "Agent Teams Engineering Foundation configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "capabilities"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "architecture.source-dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configPath"],
          "properties": {
            "configPath": {
              "$ref": "#/$defs/repositoryRelativeYamlPath"
            }
          }
        },
        "workspace.dependency-declarations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configPath"],
          "properties": {
            "configPath": {
              "$ref": "#/$defs/repositoryRelativeYamlPath"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "repositoryRelativeYamlPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.ya?ml$"
    }
  }
}
