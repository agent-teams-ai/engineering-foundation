{
  "name": "@agent-teams/engineering-foundation",
  "version": "0.5.0",
  "description": "Versioned engineering policy, tooling, and conformance for Agent Teams repositories.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build tsconfig.json --pretty false"
  },
  "bin": {
    "agent-teams-foundation": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./local-mode": {
      "types": "./dist/local-mode/index.d.ts",
      "import": "./dist/local-mode/index.js"
    },
    "./scaffolding": {
      "types": "./dist/scaffolding/index.d.ts",
      "import": "./dist/scaffolding/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./presets/*": "./presets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "presets",
    "schemas",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-teams-ai/engineering-foundation.git",
    "directory": "packages/engineering-foundation"
  },
  "homepage": "https://github.com/agent-teams-ai/engineering-foundation#readme",
  "bugs": {
    "url": "https://github.com/agent-teams-ai/engineering-foundation/issues"
  },
  "agentTeamsFoundation": {
    "metadataSchemaVersion": 1,
    "localModeProtocolVersion": 1,
    "compatibleLocalModeProtocolVersions": [
      1
    ]
  },
  "dependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@microsoft/api-extractor-model": "catalog:",
    "ajv": "catalog:",
    "oxc-parser": "catalog:",
    "proper-lockfile": "catalog:",
    "yaml": "catalog:"
  }
}
