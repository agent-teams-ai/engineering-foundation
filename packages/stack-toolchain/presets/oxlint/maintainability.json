{
  "rules": {
    "complexity": ["error", 20],
    "max-depth": ["error", 4],
    "max-lines": [
      "error",
      {
        "max": 500,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 150,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-params": ["error", 5]
  }
}
