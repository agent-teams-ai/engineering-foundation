{
  "schemaVersion": 2,
  "projectId": "foundation-fixture",
  "catalog": {
    "metadataSchemaPath": "docs/metadata.schema.json",
    "ownerCatalog": {
      "path": "docs/owners.yaml",
      "contract": "foundation.owner-map/v1"
    },
    "collections": [
      {
        "kind": "markdown-tree",
        "root": "docs"
      }
    ],
    "metadataSidecar": {
      "kind": "path-metadata-map",
      "path": "docs/metadata.sidecar.yaml"
    }
  },
  "authoring": {
    "mode": "create-only",
    "artifactTypes": [
      {
        "type": "adr",
        "initialStatus": "proposed",
        "allowedOwnerIds": [
          "architecture",
          "platform/runtime"
        ],
        "identity": {
          "kind": "explicit",
          "format": "adr-four-digits"
        },
        "placement": {
          "kind": "collection",
          "directory": "docs/decisions",
          "filename": "numeric-id-slug"
        },
        "template": {
          "kind": "fenced-markdown-body",
          "path": "docs/templates/adr.md"
        },
        "heading": {
          "kind": "id-colon-title"
        },
        "reachability": {
          "kind": "manual-fixed-index",
          "indexPath": "docs/decisions/README.md"
        }
      }
    ]
  }
}
