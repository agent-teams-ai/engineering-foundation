{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams.ai/schemas/docs-consumer-managed-state/v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cohortId",
    "cohortAuthority",
    "repository",
    "packages",
    "schemas",
    "runtime",
    "profilePath",
    "skillPath",
    "callerWorkflowPath",
    "managedStatePath",
    "assets",
    "stateDigest",
    "workflow"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "cohortId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "cohortAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "recordDigest",
        "qualificationEventDigest",
        "eligibleAfter",
        "upgradeFrom",
        "rollbackTo",
        "candidateDigest"
      ],
      "properties": {
        "channel": {
          "enum": [
            "rc",
            "stable"
          ]
        },
        "recordDigest": {
          "$ref": "https://agent-teams.ai/schemas/qualified-docs-cohort/v3#/$defs/nonzeroSha256"
        },
        "qualificationEventDigest": {
          "$ref": "https://agent-teams.ai/schemas/qualified-docs-cohort/v3#/$defs/nonzeroSha256"
        },
        "eligibleAfter": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "upgradeFrom": {
          "$ref": "https://agent-teams.ai/schemas/qualified-docs-cohort/v3#/$defs/cohortIds"
        },
        "rollbackTo": {
          "$ref": "https://agent-teams.ai/schemas/qualified-docs-cohort/v3#/$defs/cohortIds"
        },
        "candidateDigest": {
          "$ref": "https://agent-teams.ai/schemas/qualified-docs-cohort/v3#/$defs/cohortCore/properties/candidateDigest"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "id",
        "nameWithOwner"
      ],
      "properties": {
        "provider": {
          "const": "github"
        },
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "nameWithOwner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        }
      }
    },
    "packages": {
      "$ref": "https://agent-teams.ai/schemas/qualified-docs-cohort/v3#/$defs/cohortCore/properties/packages"
    },
    "schemas": {
      "$ref": "https://agent-teams.ai/schemas/qualified-docs-cohort/v3#/$defs/cohortCore/properties/schemas"
    },
    "runtime": {
      "$ref": "https://agent-teams.ai/schemas/qualified-docs-cohort/v3#/$defs/cohortCore/properties/runtime"
    },
    "profilePath": {
      "const": "architecture/foundation/docs-protocol.yaml"
    },
    "skillPath": {
      "const": ".agents/skills/docs-authoring/SKILL.md"
    },
    "callerWorkflowPath": {
      "const": ".github/workflows/docs-protocol.yml"
    },
    "managedStatePath": {
      "const": "architecture/foundation/docs-protocol-managed-state.json"
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillDigest",
        "callerWorkflowDigest",
        "assetCatalogDigest",
        "transitionCatalogDigest",
        "agentsRouteDigest",
        "docsScriptsDigest"
      ],
      "properties": {
        "skillDigest": {
          "$ref": "https://agent-teams.ai/schemas/qualified-docs-cohort/v3#/$defs/nonzeroSha256"
        },
        "callerWorkflowDigest": {
          "$ref": "https://agent-teams.ai/schemas/qualified-docs-cohort/v3#/$defs/nonzeroSha256"
        },
        "assetCatalogDigest": {
          "$ref": "https://agent-teams.ai/schemas/qualified-docs-cohort/v3#/$defs/nonzeroSha256"
        },
        "transitionCatalogDigest": {
          "$ref": "https://agent-teams.ai/schemas/qualified-docs-cohort/v3#/$defs/nonzeroSha256"
        },
        "agentsRouteDigest": {
          "$ref": "https://agent-teams.ai/schemas/qualified-docs-cohort/v3#/$defs/nonzeroSha256"
        },
        "docsScriptsDigest": {
          "$ref": "https://agent-teams.ai/schemas/qualified-docs-cohort/v3#/$defs/nonzeroSha256"
        }
      }
    },
    "stateDigest": {
      "$ref": "https://agent-teams.ai/schemas/qualified-docs-cohort/v3#/$defs/nonzeroSha256"
    },
    "workflow": {
      "$ref": "https://agent-teams.ai/schemas/qualified-docs-cohort/v3#/$defs/cohortCore/properties/workflow"
    }
  }
}
