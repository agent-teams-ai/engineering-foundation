{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./packages/engineering-foundation/presets/oxlint/node.json",
    "./packages/engineering-foundation/presets/oxlint/maintainability.json"
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**"
  ],
  "overrides": [
    {
      "files": [
        "**/generated/**",
        "**/vendor/**"
      ],
      "rules": {
        "complexity": "off",
        "max-depth": "off",
        "max-lines": "off",
        "max-lines-per-function": "off",
        "max-params": "off"
      }
    },
    {
      "files": [
        "packages/engineering-foundation/src/repository-mutation/adapters/node/node-known-file-transaction.ts"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 900,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "packages/engineering-foundation/src/repository-mutation/adapters/node/node-known-file-transaction-recovery.ts"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 1400,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "scripts/pack-test.mjs",
        "spikes/**",
        "tests/**",
        "packages/source-dependency-parser-spike/**"
      ],
      "rules": {
        "complexity": ["error", 30],
        "max-depth": ["error", 5],
        "max-lines": [
          "error",
          {
            "max": 800,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "max-lines-per-function": [
          "error",
          {
            "max": 250,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "max-params": ["error", 6]
      }
    }
  ]
}
