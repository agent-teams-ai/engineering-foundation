{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-teams.ai/engineering-foundation/repository-agent-workflow/v2",
  "title": "Explicit package-manager repository agent workflow policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageManager",
    "instructions",
    "scripts",
    "changedChecks",
    "fullScanPaths"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "packageManager": { "enum": ["bun", "pnpm"] },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "claude", "gemini", "copilot"],
      "properties": {
        "canonical": { "$ref": "#/$defs/repositoryPath" },
        "claude": { "$ref": "#/$defs/repositoryPath" },
        "gemini": { "$ref": "#/$defs/repositoryPath" },
        "copilot": { "$ref": "#/$defs/repositoryPath" }
      }
    },
    "scripts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed", "fast", "full"],
      "properties": {
        "changed": { "$ref": "#/$defs/scriptName" },
        "fast": { "$ref": "#/$defs/scriptName" },
        "full": { "$ref": "#/$defs/scriptName" }
      }
    },
    "changedChecks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "script", "extensions"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "script": { "$ref": "#/$defs/scriptName" },
          "extensions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^\\.[A-Za-z0-9][A-Za-z0-9.-]{0,15}$"
            }
          },
          "passPaths": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "fullScanPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryPath" }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "scriptName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]*$"
    }
  }
}
