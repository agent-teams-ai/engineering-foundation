{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-teams.ai/engineering-foundation/contract-json-schema-releases/v1",
  "title": "JSON Schema contract release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "publicContractVersion",
    "schemaPaths",
    "fixtures",
    "released",
    "currentConsumerEvidence"
  ],
  "properties": {
    "contractId": { "$ref": "#/$defs/contractId" },
    "publicContractVersion": { "$ref": "#/$defs/semver" },
    "schemaPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryPath" }
    },
    "fixtures": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/fixture" }
    },
    "released": { "$ref": "#/$defs/released" },
    "currentConsumerEvidence": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/consumerEvidence" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "contractId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,119}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\u0000]+\\.json$"
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "schemaId", "expectation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,119}$" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "schemaId": { "type": "string", "minLength": 1, "maxLength": 500 },
        "expectation": { "enum": ["valid", "invalid"] }
      }
    },
    "consumerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumerId",
        "consumerVersion",
        "contractId",
        "contractVersion",
        "schemaSetDigest",
        "fixtureCorpusDigest",
        "evidenceDigest",
        "outcome"
      ],
      "properties": {
        "consumerId": { "$ref": "#/$defs/contractId" },
        "consumerVersion": { "$ref": "#/$defs/semver" },
        "contractId": { "$ref": "#/$defs/contractId" },
        "contractVersion": { "$ref": "#/$defs/semver" },
        "schemaSetDigest": { "$ref": "#/$defs/digest" },
        "fixtureCorpusDigest": { "$ref": "#/$defs/digest" },
        "evidenceDigest": { "$ref": "#/$defs/digest" },
        "outcome": { "enum": ["passed", "failed"] }
      }
    },
    "released": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "contractId",
        "publicContractVersion",
        "schemaSetDigest",
        "fixtureCorpusDigest",
        "supportedConsumers"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "contractId": { "$ref": "#/$defs/contractId" },
        "publicContractVersion": { "$ref": "#/$defs/semver" },
        "schemaSetDigest": { "$ref": "#/$defs/digest" },
        "fixtureCorpusDigest": { "$ref": "#/$defs/digest" },
        "supportedConsumers": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/consumerEvidence" }
        }
      }
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  }
}
