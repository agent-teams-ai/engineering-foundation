{
  "name": "@agent-teams/engineering-foundation-repository",
  "version": "0.0.0",
  "private": true,
  "description": "Repository for the Agent Teams engineering foundation.",
  "license": "Apache-2.0",
  "type": "module",
  "nx": {},
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^24.18.0 || ^26.0.0",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "standards:check": "node scripts/check-engineering-quality-standard.mts",
    "build": "tsc --build tsconfig.json --pretty false",
    "buf-qualification:e2e": "pnpm build && node scripts/buf-qualification-e2e.mjs",
    "buf-qualification:e2e:built": "node scripts/buf-qualification-e2e.mjs",
    "check": "pnpm standards:check && pnpm dependencies:peers:check && pnpm quality:scope:check && pnpm docs:terminology:check && pnpm lint && pnpm typecheck && pnpm foundation:check:built && pnpm release-owned-files:check && pnpm architecture:patterns && pnpm architecture:patterns:test && pnpm nx:graph:check && pnpm test:built && pnpm test:coverage:built && pnpm package:check:built && pnpm architecture:features:check",
    "verify": "pnpm security:workflows && pnpm check && pnpm buf-qualification:e2e:built && pnpm registry-install-e2e:built && pnpm published-compatibility:e2e && pnpm dead-code:check && pnpm parser-spike:check",
    "check:changed": "pnpm build && node packages/engineering-foundation/dist/cli.js agent-workflow check-changed --consumer .",
    "check:fast": "pnpm standards:check && pnpm dependencies:peers:check && pnpm docs:terminology:check && pnpm release-graph:check && pnpm test:manifests:check && pnpm lint:fast && pnpm typecheck && pnpm quality:scope:check && pnpm architecture:features:check && pnpm quality:coverage:scope",
    "dependencies:peers:check": "pnpm peers check --lockfile-only",
    "ci:full": "node scripts/request-full-pr-ci.mts",
    "ci:merge": "node scripts/merge-reviewed-pr.mts",
    "changeset": "changeset",
    "changeset:coverage": "node scripts/check-changeset-coverage.mjs",
    "clean": "node scripts/clean.mjs",
    "foundation:bootstrap": "pnpm build",
    "foundation:dogfood": "pnpm foundation:bootstrap && pnpm foundation:check:built",
    "foundation:qualification": "pnpm foundation:dogfood && pnpm package:check:built && pnpm registry-install-e2e:built && pnpm published-compatibility:e2e",
    "foundation:check": "pnpm foundation:dogfood",
    "foundation:check:built": "node packages/engineering-foundation/dist/cli.js check --consumer .",
    "lint": "pnpm lint:fast && pnpm build && pnpm lint:typed",
    "lint:fast": "oxlint --config .oxlintrc.json --deny-warnings --disable-nested-config .",
    "lint:fast:files": "oxlint --config .oxlintrc.json --deny-warnings --disable-nested-config",
    "lint:typed": "node packages/engineering-foundation/dist/cli.js quality check --consumer .",
    "lint:typed:files": "oxlint --config .oxlintrc.type-aware.json --deny-warnings --disable-nested-config",
    "quality:gate:fast": "pnpm build && node packages/engineering-foundation/dist/cli.js gate run fast --consumer .",
    "architecture:patterns": "node scripts/run-ast-grep.mjs scan --config sgconfig.yml --error=unused-suppression",
    "architecture:patterns:test": "node scripts/run-ast-grep.mjs test --config sgconfig.yml --skip-snapshot-tests",
    "dead-code:check": "knip --config knip.json --no-progress",
    "docs:terminology:check": "node scripts/check-documentation-terminology.mjs",
    "nx:graph:check": "nx show projects",
    "node-compatibility:qualification": "pnpm build && node scripts/prepare-package.mjs && node scripts/node-engine-compatibility.mjs",
    "npm-package-bootstrap:candidate-evidence": "node scripts/npm-package-bootstrap-candidate-evidence.mjs",
    "published-compatibility:e2e": "node scripts/published-compatibility-e2e.mjs",
    "public-docs-release:e2e": "node scripts/public-docs-release-e2e.mjs",
    "public-managed-registry-canary": "node scripts/public-managed-registry-canary.mjs",
    "check:affected": "nx affected -t build --exclude=@agent-teams/engineering-foundation-repository",
    "package:check": "pnpm build && pnpm package:check:built",
    "package:check:built": "node scripts/prepare-package.mjs && node scripts/check-publishable-packages.mjs && node scripts/pack-test.mjs",
    "package:group:built": "node scripts/qualify-package-group.mts",
    "parser-spike:check": "pnpm --filter @agent-teams/source-dependency-parser-spike run check",
    "registry-install-e2e": "pnpm build && pnpm package:qualification:built",
    "registry-install-e2e:built": "node scripts/registry-install-e2e.mjs",
    "release:publish": "pnpm build && pnpm buf-qualification:e2e:built && pnpm registry-install-e2e:built && pnpm published-compatibility:e2e && node scripts/release-publish.mjs && pnpm public-docs-release:e2e",
    "release-owned-files:check": "node scripts/check-release-owned-files.mjs",
    "release-graph:check": "node scripts/check-release-graph-projections.mjs",
    "security:workflows": "node scripts/security-toolchain.mjs",
    "release:version": "changeset version && pnpm build && node packages/engineering-foundation/dist/cli.js public-api-promote-release --consumer .",
    "spike:source-parser": "pnpm --filter @agent-teams/source-dependency-parser-spike run spike",
    "test": "pnpm build && pnpm test:built",
    "test:built": "node scripts/run-built-tests.mjs",
    "test:coverage": "pnpm build && pnpm test:coverage:built",
    "test:coverage:built": "node scripts/run-test-coverage.mjs",
    "test:coverage:evidence:built": "node scripts/merge-test-coverage-evidence.mjs",
    "test:manifests:check": "node scripts/check-test-manifests.mjs",
    "test:performance:built": "node scripts/run-performance-benchmarks.mjs",
    "test:qgr:lifecycle:built": "node scripts/run-selected-tests.mjs tests/quality-gate-runner.test.mjs tests/quality-gate-runner-lifecycle.test.mjs tests/quality-gate-runner-real-pnpm-lifecycle.test.mjs tests/quality-gate-runner-remediation.test.mjs",
    "test:shard:built": "node scripts/run-test-shard.mjs",
    "typecheck": "tsc --build tsconfig.json --pretty false && pnpm typecheck:ci-tooling && pnpm typecheck:restoration-lock-inputs && pnpm typecheck:restoration-lock && pnpm typecheck:managed-runtime-tests && pnpm typecheck:agent-workflow",
    "typecheck:ci-tooling": "tsc --project tsconfig.ci-tooling.json",
    "typecheck:restoration-lock-inputs": "tsc --project tsconfig.restoration-lock-inputs-tests.json --skipLibCheck false",
    "typecheck:restoration-lock": "tsc --project tsconfig.restoration-lock-tests.json --skipLibCheck false",
    "typecheck:managed-runtime-tests": "tsc --project tsconfig.managed-runtime-tests.json --pretty false",
    "quality:scope:check": "node scripts/check-production-quality.mjs",
    "architecture:features:check": "pnpm build && node scripts/check-feature-modules.mjs",
    "architecture:features:plan": "node scripts/check-feature-modules.mjs plan",
    "quality:coverage:scope": "node packages/engineering-foundation/dist/cli.js quality check --consumer . --scope-only",
    "package:qualification:built": "node scripts/qualify-package-artifacts.mts",
    "typecheck:agent-workflow": "tsc --project tsconfig.agent-workflow-tests.json --pretty false"
  },
  "devDependencies": {
    "@ast-grep/cli": "catalog:",
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@openai/codex": "catalog:",
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "c8": "catalog:",
    "esbuild": "catalog:",
    "fast-check": "catalog:",
    "knip": "catalog:",
    "nx": "catalog:",
    "oxc-parser": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pnpm": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "verdaccio": "catalog:",
    "yaml": "catalog:"
  }
}
